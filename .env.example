# Safe to expose in the browser; use only the Supabase anon/public key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side ingestion only. Never prefix these with VITE_.
NASA_EARTHDATA_USERNAME=YOUR_EARTHDATA_USERNAME
NASA_EARTHDATA_PASSWORD=YOUR_EARTHDATA_PASSWORD
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY
